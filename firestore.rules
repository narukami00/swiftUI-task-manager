rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userID}/tasks/{taskID} {
      function owner() {
        return request.auth != null && request.auth.uid == userID;
      }
      function validTask() {
        let d = request.resource.data;
        return d.keys().hasAll(['title', 'notes', 'isDone', 'createdAt', 'updatedAt'])
          && d.keys().hasOnly(['title', 'notes', 'isDone', 'createdAt', 'updatedAt'])
          && d.title is string && d.title.size() >= 1 && d.title.size() <= 120
          && d.title.matches('.*[^\\s].*')
          && d.notes is string && d.notes.size() <= 500
          && d.isDone is bool
          && d.createdAt is timestamp && d.updatedAt is timestamp;
      }
      allow read, delete: if owner();
      allow create: if owner() && validTask()
        && request.resource.data.isDone == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if owner() && validTask()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }
  }
}
